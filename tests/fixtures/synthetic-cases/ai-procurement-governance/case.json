  "case_id": "ai-procurement-governance",
  "title": "AI-Assisted Case Triage Procurement",
  "domain": "Artificial intelligence, AI ethics, technology policy, and public-sector governance",
  "decision_owner": "Public-service technology and ethics board",
  "decision_question": "Choose whether and how to use AI for benefit-case triage while preserving accuracy, privacy, group equity, contestability, and fiscal feasibility.",
  "time_horizon": "24 months",
  "risk_aversion": 0.5,
  "max_constraint_violation_rate": 0.08,
  "sensitivity_weight_multiplier": 1.6,
  "evidence": {
    "type": "Synthetic benchmark, red-team, and service-design estimates",
    "decision_use": "illustrative",
    "as_of": "Synthetic demonstration; no production as-of date",
    "sources": [
      "Illustrative offline benchmark by claimant group",
      "Synthetic distribution-shift and security scenarios",
      "Hypothetical human-factors review"
    ],
    "causal_claim_status": "No causal claim; task-benefit and harm inputs are prospective scenario estimates.",
    "limitations": [
      "Offline error rates may not predict outcomes after staff adapt to the system.",
      "Contestability and dignity are represented imperfectly by numerical scores.",
      "Security threats and vendor lock-in are simplified.",
      "The Gaussian copula and factor loadings are synthetic assumptions; tail dependence may differ in real data and requires domain approval."
    ]
  },
  "criteria": [
    {
      "id": "task_benefit",
      "label": "Processing-time reduction",
      "direction": "maximize",
      "weight": 0.2,
      "unit": "percent",
      "scale": {
        "worst": 0,
        "best": 55
      }
    },
    {
      "id": "severe_error_rate",
      "label": "Severe case-error rate",
      "direction": "minimize",
      "weight": 0.24,
      "unit": "percent",
      "scale": {
        "worst": 15,
        "best": 1
      }
    },
    {
      "id": "group_error_gap",
      "label": "Maximum group error gap",
      "direction": "minimize",
      "weight": 0.18,
      "unit": "percentage points",
      "scale": {
        "worst": 12,
        "best": 0.5
      }
    },
    {
      "id": "privacy_risk",
      "label": "Privacy and security risk",
      "direction": "minimize",
      "weight": 0.15,
      "unit": "index points",
      "scale": {
        "worst": 90,
        "best": 5
      }
    },
    {
      "id": "contestability",
      "label": "Contestability and human control",
      "direction": "maximize",
      "weight": 0.13,
      "unit": "score",
      "scale": {
        "worst": 0.2,
        "best": 1
      }
    },
    {
      "id": "annual_cost",
      "label": "Annualized cost",
      "direction": "minimize",
      "weight": 0.1,
      "unit": "USD millions",
      "scale": {
        "worst": 15,
        "best": 4
      }
    }
  ],
  "constraints": [
    {
      "criterion": "severe_error_rate",
      "operator": "<=",
      "threshold": 8,
      "label": "Maximum severe-error rate"
    },
    {
      "criterion": "privacy_risk",
      "operator": "<=",
      "threshold": 55,
      "label": "Privacy and security tolerance"
    }
  ],
  "scenarios": [
